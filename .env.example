# Copy to `.env` and restart Expo (`npx expo start --clear`).
# Never commit real secrets to git.

# --- Seamless Google (Kairos Cloud Functions) ---
# Defaults point at the deployed kairos-ai-13e53 functions.
# Override only if your deploy URLs differ.
EXPO_PUBLIC_GOOGLE_OAUTH_START_URL=https://googleoauthstart-terdg5ahya-uc.a.run.app
EXPO_PUBLIC_IMPORT_GOOGLE_URL=https://importgoogle-terdg5ahya-uc.a.run.app
EXPO_PUBLIC_EXPORT_GOOGLE_URL=https://exportgoogle-terdg5ahya-uc.a.run.app
EXPO_PUBLIC_GOOGLE_STATUS_URL=https://googlestatus-terdg5ahya-uc.a.run.app

# Legacy client-side OAuth (optional fallback for Outlook / local prototypes)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_MICROSOFT_CLIENT_ID=
EXPO_PUBLIC_MICROSOFT_TENANT_ID=common

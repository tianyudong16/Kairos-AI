# Copy to `.env` and restart Expo (`npx expo start --clear`).
# Never commit real secrets to git.

# --- Required for seamless Google Connect (public Firebase web config) ---
# Firebase Console → Project settings → Your apps → Web app → Config
# Project: kairos-ai-13e53
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=kairos-ai-13e53.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=kairos-ai-13e53
EXPO_PUBLIC_FIREBASE_APP_ID=

# Backend Google OAuth start (Cloud Function). Defaults to this if unset:
# EXPO_PUBLIC_GOOGLE_OAUTH_START_URL=https://us-central1-kairos-ai-13e53.cloudfunctions.net/googleOAuthStart

# --- Outlook prototype (optional; backend Connect coming next) ---
# Azure Portal → App registrations → Redirect: kairosai://oauth
EXPO_PUBLIC_MICROSOFT_CLIENT_ID=
EXPO_PUBLIC_MICROSOFT_TENANT_ID=common

# --- Deprecated: not needed for Google Connect anymore (secrets live in Functions) ---
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

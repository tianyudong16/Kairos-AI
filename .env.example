# Copy to `.env` and restart Expo (`npx expo start --clear`).
# Never commit real secrets to git.

# Google Cloud → APIs & Services → enable "Google Calendar API"
# Create OAuth client IDs for Web / iOS / Android.
# Authorized redirect URI example (web): http://localhost:8081
# Native scheme redirect: kairosai://oauth
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Azure Portal → App registrations → New registration
# Platform: Mobile and desktop / SPA
# Redirect URI: kairosai://oauth  (and your web origin if testing on web)
# API permissions: Calendars.ReadWrite, User.Read, offline_access (Delegated)
EXPO_PUBLIC_MICROSOFT_CLIENT_ID=
EXPO_PUBLIC_MICROSOFT_TENANT_ID=common

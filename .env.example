# Copy to `.env` and restart Expo (`npx expo start --clear`).
# Never commit real secrets to git.

# Public URL where the web app is hosted (OAuth returns here after Google sign-in).
# Set when deploying; defaults to window.location.origin in the browser.
EXPO_PUBLIC_APP_URL=https://kairos-ai-13e53.web.app

# --- Seamless Google (Kairos Cloud Functions) ---
# Defaults point at the deployed kairos-ai-13e53 functions.
# Override only if your deploy URLs differ.
EXPO_PUBLIC_GOOGLE_OAUTH_START_URL=https://googleoauthstart-terdg5ahya-uc.a.run.app
EXPO_PUBLIC_IMPORT_GOOGLE_URL=https://importgoogle-terdg5ahya-uc.a.run.app
EXPO_PUBLIC_EXPORT_GOOGLE_URL=https://exportgoogle-terdg5ahya-uc.a.run.app
EXPO_PUBLIC_GOOGLE_STATUS_URL=https://googlestatus-terdg5ahya-uc.a.run.app

# --- Multi-user Kairos accounts (Cloud Functions) ---
EXPO_PUBLIC_AUTH_REGISTER_URL=https://authregister-terdg5ahya-uc.a.run.app
EXPO_PUBLIC_AUTH_LOGIN_URL=https://authlogin-terdg5ahya-uc.a.run.app
EXPO_PUBLIC_AUTH_LOGOUT_URL=https://authlogout-terdg5ahya-uc.a.run.app
EXPO_PUBLIC_AUTH_ME_URL=https://authme-terdg5ahya-uc.a.run.app
EXPO_PUBLIC_WORKSPACE_GET_URL=https://getuserworkspace-terdg5ahya-uc.a.run.app
EXPO_PUBLIC_WORKSPACE_SAVE_URL=https://saveuserworkspace-terdg5ahya-uc.a.run.app

# AI Coach (OpenAI via Cloud Function)
EXPO_PUBLIC_COACH_CHAT_URL=https://coachchat-terdg5ahya-uc.a.run.app

# Legacy client-side OAuth (optional fallback for Outlook / local prototypes)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_MICROSOFT_CLIENT_ID=
EXPO_PUBLIC_MICROSOFT_TENANT_ID=common
